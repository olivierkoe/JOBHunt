# Copie ce fichier en .env et remplis les valeurs. Ne commite jamais .env.

# PostgreSQL (./start-database.sh lance un conteneur Docker local avec cette URL)
DATABASE_URL="postgresql://postgres:password@localhost:5432/jobhunt"

# Mot de passe de l'appli (Basic Auth, utilisateur "admin"), 12 caractères minimum.
# Obligatoire en production : sans lui l'appli répond 503.
APP_PASSWORD=""

# Secret du cron (appel de /api/cron/watch avec "Authorization: Bearer <CRON_SECRET>"), 24 caractères minimum.
# Génère-le avec : openssl rand -hex 32
CRON_SECRET=""

# Optionnel : notifications push via https://ntfy.sh (nouvelles offres, relances dues)
NTFY_TOPIC=""

# Signature des messages de relance et de prise de contact
CANDIDATE_NAME="Olivier Koenig"

# Lien vers tes projets, inséré dans les messages aux startups qui viennent de lever
PORTFOLIO_URL="https://4thunes.ovh"

# Veille : sources surveillées (séparées par des virgules)
WATCH_SUBREDDITS="forhire,remotejs,jobbit,PHPjobs,hiring,RemoteJobs"
# Recherches Reddit (syntaxe de recherche Reddit, une par stack)
WATCH_REDDIT_QUERIES="php OR symfony,node OR nestjs OR react OR angular"
WATCH_REMOTIVE_QUERIES="php,symfony,node,nestjs,react,angular"
# Mots-clés seuls (France Travail, Jooble) et une recherche par stack (Adzuna, Google Jobs)
WATCH_KEYWORDS="php,symfony,node.js,nestjs,react,angular"
WATCH_STACK_QUERIES="php symfony,node nestjs react angular"

# Agrégateurs : on garde le télétravail complet, plus les postes sur site / hybrides dans cette zone.
# Termes de lieu séparés par des virgules, le premier sert de lieu de recherche. Vide : télétravail uniquement.
WATCH_ZONE=""
# Départements France Travail de la zone (ex. "34,30")
WATCH_FT_DEPARTEMENTS=""

# Agrégateurs d'offres (reprennent LinkedIn, Indeed, Welcome to the Jungle…). Chaque source est ignorée sans sa clé.
# France Travail : https://francetravail.io (application avec l'API « Offres d'emploi v2 »)
FRANCE_TRAVAIL_CLIENT_ID=""
FRANCE_TRAVAIL_CLIENT_SECRET=""
# Google Jobs via https://serpapi.com (2 recherches par jour)
SERPAPI_API_KEY=""
# https://developer.adzuna.com
ADZUNA_APP_ID=""
ADZUNA_APP_KEY=""
# https://jooble.org/api/about
JOOBLE_API_KEY=""

# Reddit bloque les accès anonymes (403 / 429) : crée une application de type "script"
# sur https://www.reddit.com/prefs/apps et colle ici son identifiant (sous le nom) et son secret.
REDDIT_CLIENT_ID=""
REDDIT_CLIENT_SECRET=""
